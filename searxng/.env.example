### searngx
# By default listen on https://localhost
# To change this:
# * uncomment SEARXNG_HOSTNAME, and replace <host> by the SearXNG hostname
# * uncomment LETSENCRYPT_EMAIL, and replace <email> by your email (require to create a Let's Encrypt certificate)

SEARXNG_HOSTNAME=searxng:8080
# LETSENCRYPT_EMAIL=<email>

# SearXNG session-signing secret - generate with: openssl rand -hex 24
SEARXNG_SECRET=

# Brave Search API key (optional). Leave empty to keep the engine set
# [duckduckgo, wikipedia, mwmbl]. Set a key from api-dashboard.search.brave.com
# and run `docker compose up -d` to activate the braveapi engine.
BRAVE_API_KEY=

