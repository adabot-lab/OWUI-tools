# MCP streamable HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=8000

# DNS-rebinding protection (comma-separated host:port values).
# Empty = protection disabled (trusted local/Docker networks).
# For public exposure: MCP_ALLOWED_HOSTS=your.domain.com:8000
MCP_ALLOWED_HOSTS=

# Input directory for raw law markdown (from Convert_to_MD)
LEGAL_DOCUMENTS_DIR=input

# SQLite database path (generated by extraction pipeline)
LEGAL_DB_PATH=data/legal.db

# LLM endpoint for extraction pipeline (not needed at runtime)
# LLM_BASE_URL=http://localhost:4000/v1
# LLM_EXTRACT_MODEL=zai-glm-4.7
