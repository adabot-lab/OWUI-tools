# ==================== OMNIROUTE (testing, alongside litellm) ====================
# Dashboard :20128 — /v1 API :20129 (two-port variant). Live-WS :20132 internal.
# Copy to .env and fill in. Secrets: openssl rand -base64 48 / -hex 32.

# --- REQUIRED SECRETS ---
# JWT signing key for dashboard sessions
JWT_SECRET=KEY_AAAA
# Encryption key for API keys stored in the DB
API_KEY_SECRET=KEY_AAAA
# WebSocket bridge shared secret
OMNIROUTE_WS_BRIDGE_SECRET=KEY_AAAA
# Initial dashboard admin password (change after first login)
INITIAL_PASSWORD=KEY_AAAA
# Optional: encrypt SQLite at rest (empty = off)
STORAGE_ENCRYPTION_KEY=

# --- SECURITY ---
# Require dashboard-created API keys on all /v1/* calls (user-approved)
REQUIRE_API_KEY=true
# MUST stay false while on plain HTTP (ip:port); true only behind HTTPS
AUTH_COOKIE_SECURE=false

# --- NETWORK ---
# NEXT_PUBLIC_BASE_URL=http://192.168.0.209:20128   # optional, dashboard links
# Live-WS (20132) is internal/loopback-only. To enable LAN live-view later:
#   LIVE_WS_HOST=0.0.0.0 + publish 20132 + LIVE_WS_ALLOWED_ORIGINS=<dashboard origin>

# --- PROVIDERS ---
# NO provider API keys here (user decision 2026-08-21). ALL providers —
# openrouter, glm/z.ai, deepseek, mistral, gemini, groq — are added in
# Dashboard -> Providers after first login. (v3.8.0 dropped env keys for
# openrouter/glm/mistral/groq anyway; deepseek/gemini env fallbacks unused.)

# --- RUNTIME ---
# Node heap ceiling MB (host .209 has ~2.5G free RAM)
OMNIROUTE_MEMORY_MB=1024
